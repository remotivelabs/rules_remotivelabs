        <SYSTEM-SIGNAL>
          <SHORT-NAME>ClimateSetpoint</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>ClimateState</SHORT-NAME>
