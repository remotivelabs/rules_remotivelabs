        <!-- ============================================================ Gateway routing -->
        <GATEWAY>
          <SHORT-NAME>GatewayEcuRouting</SHORT-NAME>
          <ECU-REF DEST="ECU-INSTANCE">/DummyVehicle/GatewayEcu</ECU-REF>
