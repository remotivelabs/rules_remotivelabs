<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic ECU extract for gateway-mapping tests. One gateway ECU
     (GatewayEcu) forwards PDUs across four routes covering every channel-type
     combination the extractor supports:

       1. CAN -> CAN:  SensorFrame01   (BodyCAN)            -> ActuatorFrame01        (ChassisCAN)
       2. CAN -> ETH:  SensorFrame01   (BodyCAN)            -> PtBackboneStatusPdu01  (BackboneETH socket pair)
       3. ETH -> LIN:  PtBackboneCommandPdu01 (BackboneETH) -> ClimateFrame01         (CabinLIN)
       4. LIN -> CAN:  ClimateStateFrame01 (CabinLIN)       -> ClimateStateCanFrame01 (ChassisCAN)

     Written from scratch for rules_remotivelabs — contains no customer data. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-3-1.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>DummyVehicle</SHORT-NAME>
      <ELEMENTS>
        <!-- ============================================================ ECUs -->
        <ECU-INSTANCE>
          <SHORT-NAME>SensorEcu</SHORT-NAME>
          <CONNECTORS>
            <CAN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>SensorBodyCanConn</SHORT-NAME>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>SensorPduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>SensorFrameOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </CAN-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>ActuatorEcu</SHORT-NAME>
          <CONNECTORS>
            <CAN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>ActuatorChassisCanConn</SHORT-NAME>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>ActuatorPduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>ActuatorStatePduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>ActuatorFrameIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </CAN-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>ClimateEcu</SHORT-NAME>
          <COMM-CONTROLLERS>
            <LIN-SLAVE>
              <SHORT-NAME>ClimateLinSlave</SHORT-NAME>
            </LIN-SLAVE>
          </COMM-CONTROLLERS>
          <CONNECTORS>
            <LIN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>ClimateCabinLinConn</SHORT-NAME>
              <COMM-CONTROLLER-REF DEST="LIN-SLAVE">/DummyVehicle/ClimateEcu/ClimateLinSlave</COMM-CONTROLLER-REF>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>ClimatePduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>ClimateStatePduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </LIN-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>TelematicsEcu</SHORT-NAME>
          <CONNECTORS>
            <ETHERNET-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>TelematicsBackboneEthConn</SHORT-NAME>
              <NETWORK-ENDPOINT-REFS>
                <NETWORK-ENDPOINT-REF DEST="NETWORK-ENDPOINT">/DummyVehicle/BackboneETH/BackboneETHChannel/TelematicsBackboneEp</NETWORK-ENDPOINT-REF>
              </NETWORK-ENDPOINT-REFS>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>TelematicsStatusPduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>TelematicsCommandPduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </ETHERNET-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>GatewayEcu</SHORT-NAME>
          <COMM-CONTROLLERS>
            <LIN-MASTER>
              <SHORT-NAME>GatewayLinMaster</SHORT-NAME>
              <LIN-MASTER-VARIANTS>
                <LIN-MASTER-CONDITIONAL>
                  <LIN-SLAVES>
                  </LIN-SLAVES>
                </LIN-MASTER-CONDITIONAL>
              </LIN-MASTER-VARIANTS>
            </LIN-MASTER>
          </COMM-CONTROLLERS>
          <CONNECTORS>
            <CAN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>GatewayBodyCanConn</SHORT-NAME>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayBodyPduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>GatewayBodyFrameIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </CAN-COMMUNICATION-CONNECTOR>
            <CAN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>GatewayChassisCanConn</SHORT-NAME>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayChassisPduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayChassisStatePduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>GatewayChassisFrameOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </CAN-COMMUNICATION-CONNECTOR>
            <LIN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>GatewayCabinLinConn</SHORT-NAME>
              <COMM-CONTROLLER-REF DEST="LIN-MASTER">/DummyVehicle/GatewayEcu/GatewayLinMaster</COMM-CONTROLLER-REF>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayCabinPduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayCabinStatePduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </LIN-COMMUNICATION-CONNECTOR>
            <ETHERNET-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>GatewayBackboneEthConn</SHORT-NAME>
              <NETWORK-ENDPOINT-REFS>
                <NETWORK-ENDPOINT-REF DEST="NETWORK-ENDPOINT">/DummyVehicle/BackboneETH/BackboneETHChannel/GatewayBackboneEp</NETWORK-ENDPOINT-REF>
              </NETWORK-ENDPOINT-REFS>
              <ECU-COMM-PORT-INSTANCES>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayBackboneStatusPduOut</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>GatewayBackboneCommandPduIn</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </ETHERNET-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <!-- ============================================================ CAN clusters -->
        <CAN-CLUSTER>
          <SHORT-NAME>BodyCAN</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>BodyCANChannel</SHORT-NAME>
                  <COMM-CONNECTORS>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/DummyVehicle/SensorEcu/SensorBodyCanConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/DummyVehicle/GatewayEcu/GatewayBodyCanConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                  </COMM-CONNECTORS>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FtSensorFrame01</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/SensorEcu/SensorBodyCanConn/SensorFrameOut</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/GatewayEcu/GatewayBodyCanConn/GatewayBodyFrameIn</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/DummyVehicle/SensorFrame01</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/DummyVehicle/BodyCAN/BodyCANChannel/PtSensorPdu01</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>257</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtSensorPdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/SensorEcu/SensorBodyCanConn/SensorPduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayBodyCanConn/GatewayBodyPduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/SensorPdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
        <CAN-CLUSTER>
          <SHORT-NAME>ChassisCAN</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>ChassisCANChannel</SHORT-NAME>
                  <COMM-CONNECTORS>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/DummyVehicle/GatewayEcu/GatewayChassisCanConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/DummyVehicle/ActuatorEcu/ActuatorChassisCanConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                  </COMM-CONNECTORS>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FtActuatorFrame01</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/GatewayEcu/GatewayChassisCanConn/GatewayChassisFrameOut</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/ActuatorEcu/ActuatorChassisCanConn/ActuatorFrameIn</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/DummyVehicle/ActuatorFrame01</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/DummyVehicle/ChassisCAN/ChassisCANChannel/PtActuatorPdu01</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>513</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>FtClimateStateCanFrame01</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/GatewayEcu/GatewayChassisCanConn/GatewayChassisFrameOut</FRAME-PORT-REF>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/DummyVehicle/ActuatorEcu/ActuatorChassisCanConn/ActuatorFrameIn</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/DummyVehicle/ClimateStateCanFrame01</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/DummyVehicle/ChassisCAN/ChassisCANChannel/PtClimateStateCanPdu01</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <IDENTIFIER>514</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtActuatorPdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayChassisCanConn/GatewayChassisPduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/ActuatorEcu/ActuatorChassisCanConn/ActuatorPduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/SensorPdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtClimateStateCanPdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayChassisCanConn/GatewayChassisStatePduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/ActuatorEcu/ActuatorChassisCanConn/ActuatorStatePduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/ClimateStatePdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
        <!-- ============================================================ LIN cluster -->
        <LIN-CLUSTER>
          <SHORT-NAME>CabinLIN</SHORT-NAME>
          <LIN-CLUSTER-VARIANTS>
            <LIN-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <LIN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>CabinLINChannel</SHORT-NAME>
                  <COMM-CONNECTORS>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="LIN-COMMUNICATION-CONNECTOR">/DummyVehicle/GatewayEcu/GatewayCabinLinConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="LIN-COMMUNICATION-CONNECTOR">/DummyVehicle/ClimateEcu/ClimateCabinLinConn</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                  </COMM-CONNECTORS>
                  <FRAME-TRIGGERINGS>
                    <LIN-FRAME-TRIGGERING>
                      <SHORT-NAME>FtClimateFrame01</SHORT-NAME>
                      <FRAME-REF DEST="LIN-FRAME">/DummyVehicle/ClimateFrame01</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/DummyVehicle/CabinLIN/CabinLINChannel/PtClimatePdu01</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <IDENTIFIER>16</IDENTIFIER>
                    </LIN-FRAME-TRIGGERING>
                    <LIN-FRAME-TRIGGERING>
                      <SHORT-NAME>FtClimateStateFrame01</SHORT-NAME>
                      <FRAME-REF DEST="LIN-FRAME">/DummyVehicle/ClimateStateFrame01</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/DummyVehicle/CabinLIN/CabinLINChannel/PtClimateStatePdu01</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <IDENTIFIER>17</IDENTIFIER>
                    </LIN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtClimatePdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayCabinLinConn/GatewayCabinPduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/ClimateEcu/ClimateCabinLinConn/ClimatePduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/ClimatePdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtClimateStatePdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/ClimateEcu/ClimateCabinLinConn/ClimateStatePduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayCabinLinConn/GatewayCabinStatePduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/ClimateStatePdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </LIN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </LIN-CLUSTER-CONDITIONAL>
          </LIN-CLUSTER-VARIANTS>
        </LIN-CLUSTER>
        <!-- ============================================================ Ethernet cluster -->
        <ETHERNET-CLUSTER>
          <SHORT-NAME>BackboneETH</SHORT-NAME>
          <ETHERNET-CLUSTER-VARIANTS>
            <ETHERNET-CLUSTER-CONDITIONAL>
              <PHYSICAL-CHANNELS>
                <ETHERNET-PHYSICAL-CHANNEL>
                  <SHORT-NAME>BackboneETHChannel</SHORT-NAME>
                  <NETWORK-ENDPOINTS>
                    <NETWORK-ENDPOINT>
                      <SHORT-NAME>GatewayBackboneEp</SHORT-NAME>
                      <NETWORK-ENDPOINT-ADDRESSES>
                        <IPV-4-CONFIGURATION>
                          <IPV-4-ADDRESS>10.0.0.1</IPV-4-ADDRESS>
                        </IPV-4-CONFIGURATION>
                      </NETWORK-ENDPOINT-ADDRESSES>
                    </NETWORK-ENDPOINT>
                    <NETWORK-ENDPOINT>
                      <SHORT-NAME>TelematicsBackboneEp</SHORT-NAME>
                      <NETWORK-ENDPOINT-ADDRESSES>
                        <IPV-4-CONFIGURATION>
                          <IPV-4-ADDRESS>10.0.0.2</IPV-4-ADDRESS>
                        </IPV-4-CONFIGURATION>
                      </NETWORK-ENDPOINT-ADDRESSES>
                    </NETWORK-ENDPOINT>
                  </NETWORK-ENDPOINTS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtBackboneStatusPdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayBackboneEthConn/GatewayBackboneStatusPduOut</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/TelematicsEcu/TelematicsBackboneEthConn/TelematicsStatusPduIn</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/SensorPdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PtBackboneCommandPdu01</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/GatewayEcu/GatewayBackboneEthConn/GatewayBackboneCommandPduIn</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/DummyVehicle/TelematicsEcu/TelematicsBackboneEthConn/TelematicsCommandPduOut</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/DummyVehicle/ClimatePdu01</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                  <SO-AD-CONFIG>
                    <SOCKET-ADDRESSS>
                      <SOCKET-ADDRESS>
                        <SHORT-NAME>GatewayBackboneSocket</SHORT-NAME>
                        <APPLICATION-ENDPOINT>
                          <SHORT-NAME>GatewayBackboneAppEp</SHORT-NAME>
                          <NETWORK-ENDPOINT-REF DEST="NETWORK-ENDPOINT">/DummyVehicle/BackboneETH/BackboneETHChannel/GatewayBackboneEp</NETWORK-ENDPOINT-REF>
                          <TP-CONFIGURATION>
                            <UDP-TP>
                              <UDP-TP-PORT>
                                <PORT-NUMBER>50000</PORT-NUMBER>
                              </UDP-TP-PORT>
                            </UDP-TP>
                          </TP-CONFIGURATION>
                        </APPLICATION-ENDPOINT>
                        <CONNECTOR-REF DEST="ETHERNET-COMMUNICATION-CONNECTOR">/DummyVehicle/GatewayEcu/GatewayBackboneEthConn</CONNECTOR-REF>
                        <STATIC-SOCKET-CONNECTIONS>
                          <STATIC-SOCKET-CONNECTION>
                            <SHORT-NAME>GatewayToTelematics</SHORT-NAME>
                            <I-PDU-IDENTIFIERS>
                              <SO-CON-I-PDU-IDENTIFIER-REF-CONDITIONAL>
                                <SO-CON-I-PDU-IDENTIFIER-REF DEST="SO-CON-I-PDU-IDENTIFIER">/DummyVehicle/BackboneIpduIdentifiers/SoConStatusPdu01</SO-CON-I-PDU-IDENTIFIER-REF>
                              </SO-CON-I-PDU-IDENTIFIER-REF-CONDITIONAL>
                              <SO-CON-I-PDU-IDENTIFIER-REF-CONDITIONAL>
                                <SO-CON-I-PDU-IDENTIFIER-REF DEST="SO-CON-I-PDU-IDENTIFIER">/DummyVehicle/BackboneIpduIdentifiers/SoConCommandPdu01</SO-CON-I-PDU-IDENTIFIER-REF>
                              </SO-CON-I-PDU-IDENTIFIER-REF-CONDITIONAL>
                            </I-PDU-IDENTIFIERS>
                            <REMOTE-ADDRESSS>
                              <SOCKET-ADDRESS-REF-CONDITIONAL>
                                <SOCKET-ADDRESS-REF DEST="SOCKET-ADDRESS">/DummyVehicle/BackboneETH/BackboneETHChannel/TelematicsBackboneSocket</SOCKET-ADDRESS-REF>
                              </SOCKET-ADDRESS-REF-CONDITIONAL>
                            </REMOTE-ADDRESSS>
                          </STATIC-SOCKET-CONNECTION>
                        </STATIC-SOCKET-CONNECTIONS>
                      </SOCKET-ADDRESS>
                      <SOCKET-ADDRESS>
                        <SHORT-NAME>TelematicsBackboneSocket</SHORT-NAME>
                        <APPLICATION-ENDPOINT>
                          <SHORT-NAME>TelematicsBackboneAppEp</SHORT-NAME>
                          <NETWORK-ENDPOINT-REF DEST="NETWORK-ENDPOINT">/DummyVehicle/BackboneETH/BackboneETHChannel/TelematicsBackboneEp</NETWORK-ENDPOINT-REF>
                          <TP-CONFIGURATION>
