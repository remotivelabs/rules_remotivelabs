load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//remotivelabs/rules:remotive_topology.bzl",
    "remotive_topology_build",
    "remotive_topology_gateway_mapping",
    "remotive_topology_show_instance",
)
load("//remotivelabs/tests:version_test.bzl", "version_test_suite")
load("//remotivelabs/tests:versions_test.bzl", "versions_test_suite")

# Test that public bzl files can be loaded
build_test(
    name = "public_targets_build_test",
    targets = [
        "//remotivelabs:extensions_bzl",
        "//remotivelabs/rules:remotive_topology_bzl",
    ],
)

# Starlark unit tests: the version helpers and the release manifest.
version_test_suite(name = "version_test")

versions_test_suite(name = "versions_test")

# Test that the extension creates a working topology repo for every
# (version, platform) the manifest registers. Building the sh_binary
# only assembles its runfiles tree; the binary itself doesn't run, so
# this works even when the host arch doesn't match.
build_test(
    name = "topology_extension_test",
    targets = [
        "@remotive_topology_0_30_0_linux_x86_64//:topology",
        "@remotive_topology_0_30_0_linux_aarch64//:topology",
        "@remotive_topology_0_30_0_darwin_arm64//:topology",
    ],
)

# The minimal fixture shared by the build and show rules below.
_MINIMAL_TOPOLOGY_FILES = glob([
    "fixtures/topology/instances/*.yaml",
    "fixtures/topology/models/*.yaml",
    "fixtures/topology/tests/*.yaml",
    "fixtures/topology/platform/*.yaml",
    "fixtures/topology/platform/databases/*.dbc",
]) + ["fixtures/topology/Dockerfile"]

# Exercises remotive_topology_build end-to-end. The topology binary is
# resolved through the registered toolchain (see register_toolchains in
# the root MODULE.bazel).
remotive_topology_build(
    name = "minimal_topology",
    srcs = ["fixtures/topology/instances/main.instance.yaml"],
    data = _MINIMAL_TOPOLOGY_FILES,
)

build_test(
    name = "topology_build_test",
    targets = [":minimal_topology"],
)

sh_test(
    name = "topology_build_content_test",
    srcs = ["topology_build_test.sh"],
    data = [":minimal_topology"],
    env = {"TOPOLOGY_OUT": "$(rootpath :minimal_topology)"},
)

# Exercises remotive_topology_show_instance end-to-end.
remotive_topology_show_instance(
    name = "minimal_resolved_instance",
    src = "fixtures/topology/instances/main.instance.yaml",
    data = _MINIMAL_TOPOLOGY_FILES,
)

sh_test(
    name = "instance_resolution_test",
    srcs = ["resolved_document_test.sh"],
    data = [":minimal_resolved_instance"],
    env = {"RESOLVED_OUT": "$(rootpath :minimal_resolved_instance)"},
)

# Exercises remotive_topology_gateway_mapping end-to-end. The synthetic
# ARXML fixture (written from scratch — no customer data) declares one
# gateway ECU with four forwarding routes covering every channel-type
# combination: CAN->CAN, CAN->ETH, ETH->LIN, LIN->CAN.
remotive_topology_gateway_mapping(
    name = "dummy_gateway_mapping",
    data = ["fixtures/topology/gateway/dummy_gateway.arxml"],
    format = "remotive-topology-mapping",
    gateway_ecu = "GatewayEcu",
    platform = "fixtures/topology/gateway/gateway.platform.yaml",
)

remotive_topology_gateway_mapping(
    name = "dummy_gateway_mapping_legacy",
    data = ["fixtures/topology/gateway/dummy_gateway.arxml"],
    gateway_ecu = "GatewayEcu",
    platform = "fixtures/topology/gateway/gateway.platform.yaml",
)

build_test(
    name = "gateway_mapping_build_test",
    targets = [
        ":dummy_gateway_mapping",
        ":dummy_gateway_mapping_legacy",
    ],
)

sh_test(
    name = "gateway_mapping_content_test",
    srcs = ["gateway_mapping_test.sh"],
    data = [":dummy_gateway_mapping"],
    env = {"MAPPING_OUT": "$(rootpath :dummy_gateway_mapping)"},
)
